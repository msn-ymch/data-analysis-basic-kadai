        "# NumPyをインポート\n",
        "import numpy as np\n",
        "\n",
        "# 多次元配列のコード\n",
        "A = np.arange(6).reshape(3, 2)\n",
        "B = np.arange(8).reshape(2, 4)\n",
        "\n",
        "# 行列演算\n",
        "multi_array = np.dot(A, B)\n",
        "\n",
        "# 最大値\n",
        "multi_array.max()"
      ],
